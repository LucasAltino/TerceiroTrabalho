generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum Status {
  ABERTO
  CONCLUIDO
}

model Ticket {
  id          String     @id
  title       String
  description String
  justify     String?
  prioridade  Prioridade @default(BAIXA)
  status      Status     @default(ABERTO)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  @@map("tickets")
}

enum ReturnType {
  DEVOLUTION
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  POSTED
  RECEIVED
  INSPECTING
  ADJUSTMENT_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum Role {
  CUSTOMER
  INSPECTOR
  FINANCE
  ADMIN
}

enum RefundStatus {
  PENDING
  PAID
  REVERSED
}

model User {
  id            String                @id @default(uuid())
  email         String                @unique
  passwordHash  String                @map("password_hash")
  role          Role
  returns       ReturnRequest[]       @relation("ReturnCustomer")
  statusHistory ReturnStatusHistory[] @relation("ReturnStatusAuthor")

  @@map("users")
}

model Order {
  id             String          @id @default(uuid())
  itemsTotal     Decimal         @map("items_total") @db.Decimal(12, 2)
  couponDiscount Decimal         @map("coupon_discount") @db.Decimal(12, 2)
  shippingPaid   Decimal         @map("shipping_paid") @db.Decimal(12, 2)
  amountPaid     Decimal         @map("amount_paid") @db.Decimal(12, 2)
  amountRefunded Decimal         @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  items          OrderItem[]
  returns        ReturnRequest[]
  reverseCodes   ReverseCode[]

  @@map("orders")
}

model OrderItem {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  productId   String       @map("product_id")
  unitPrice   Decimal      @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model ReturnRequest {
  id                    String                @id
  orderId               String                @map("order_id")
  customerId            String                @map("customer_id")
  productId             String                @map("product_id")
  type                  ReturnType
  reason                String
  description           String
  status                ReturnStatus          @default(REQUESTED)
  trackingCode          String?               @map("tracking_code")
  inspectionResult      String?               @map("inspection_result")
  rejectionReason       String?               @map("rejection_reason")
  adjustmentRequestedAt DateTime?             @map("adjustment_requested_at")
  adjustmentReason      String?               @map("adjustment_reason")
  version               Int                   @default(0)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  customer              User                  @relation("ReturnCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items                 ReturnItem[]
  refunds               Refund[]
  statusHistory         ReturnStatusHistory[]
  reverseCode           ReverseCode?

  @@map("return_requests")
}

model ReturnItem {
  returnRequestId String        @map("return_request_id")
  orderItemId     String        @map("order_item_id")
  quantity        Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model Refund {
  id              String        @id @default(uuid())
  returnRequestId String        @unique @map("return_request_id")
  value           Decimal       @map("valor") @db.Decimal(12, 2)
  status          RefundStatus  @default(PENDING)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model ReverseCode {
  id              String        @id @default(uuid())
  code            String        @unique
  returnRequestId String        @unique @map("return_request_id")
  orderId         String        @map("order_id")
  expiresAt       DateTime      @map("expires_at")
  usedAt          DateTime?     @map("used_at")
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("reverse_codes")
}

model ReturnStatusHistory {
  idRegistro      String        @id @default(uuid()) @map("id_registro")
  returnRequestId String        @map("return_request_id")
  estadoAnterior  ReturnStatus  @map("estado_anterior")
  novoEstado      ReturnStatus  @map("novo_estado")
  autorId         String        @map("autor_id")
  justificativa   String
  timestamp       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  author          User          @relation("ReturnStatusAuthor", fields: [autorId], references: [id], onDelete: Restrict)

  @@index([returnRequestId, timestamp])
  @@map("return_status_history")
}
